# PostgreSQL Database Connection (Docker)
DATABASE_URL=postgresql://postgres:your_local_password@localhost:5432/commandcenter

# Redis Connection (Docker)
REDIS_URL=redis://localhost:6379

# MongoDB Connection (Docker)
MONGODB_URL=mongodb://localhost:27017/commandcenter

# JWT Secret
JWT_SECRET=your_docker_jwt_secret_placeholder

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Groq API Key (for AI features)
GROQ_API_KEY=your_groq_api_key_placeholder

# Server Port
PORT=3001
