# Docker environment variables for local development (redacted placeholders)
# Do NOT commit production secrets. Use your deployment platform's secret store (Vercel/GitHub) for real values.

# PostgreSQL Database Connection (Docker)
DATABASE_URL=(ENTER_YOUR_DATABASE_URL)

# Redis Connection (Docker)
REDIS_URL=redis://localhost:6379

# MongoDB Connection (Docker)
MONGODB_URL=mongodb://localhost:27017/commandcenter

# JWT Secret
JWT_SECRET=(ENTER_YOUR_JWT_SECRET)

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=(ENTER_YOUR_EMAIL_USER)
EMAIL_PASS=(ENTER_YOUR_EMAIL_PASSWORD)

# Groq API Key (for AI features)
GROQ_API_KEY=(ENTER_YOUR_GROQ_API_KEY)

# Server Port
PORT=3001
