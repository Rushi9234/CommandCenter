DATABASE_URL=postgresql://postgres:password@localhost:5432/commandcenter
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=your_jwt_secret_here_change_in_production
PORT=3001
NODE_ENV=development

# Milestone 55: EMAIL_PROVIDER selects the EmailProvider implementation
# (see src/services/email/providers/emailProviderFactory.ts). 'console'
# (the default if unset) logs only; 'resend' sends real email and
# requires RESEND_API_KEY. 'smtp' is a temporary E2E-testing-only option
# (see smtpEmailProvider.ts) -- never use it in production; it requires
# SMTP_HOST/SMTP_PORT/SMTP_USER/SMTP_PASS below instead of RESEND_API_KEY.
EMAIL_PROVIDER=console
RESEND_API_KEY=your_resend_api_key_here

# Only used when EMAIL_PROVIDER=smtp (temporary E2E testing against a free
# SMTP sandbox such as Mailtrap -- never point this at a real mailbox).
SMTP_HOST=your_smtp_host_here
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASS=your_smtp_password_here

# The frontend's own URL -- used for CORS (app.ts) and for building
# verification/password-reset links (services/emailService.ts). Must be
# set to the real deployed frontend URL in production.
FRONTEND_URL=http://localhost:3000

# Dev/demo only -- forced false in production regardless of this value
# (see src/config/env.ts).
AUTO_VERIFY=false
