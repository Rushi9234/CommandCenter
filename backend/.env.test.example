# Template for backend/.env.test -- copy to .env.test and fill in.
# DATABASE_URL must point at a dedicated test database, never the one
# .env's DATABASE_URL points at. Tests truncate tables between runs.
NODE_ENV=test
PORT=3999
DATABASE_URL=postgresql://user:password@host/commandcenter_test?sslmode=require
GROQ_API_KEY=your_groq_api_key_here
JWT_SECRET=your_jwt_secret_here
AUTO_VERIFY=true
